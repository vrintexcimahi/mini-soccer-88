{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/superadmin/login.html" },
    { "source": "/admin", "destination": "/superadmin/index.html" },
    { "source": "/superadmin", "destination": "/superadmin/index.html" },
    { "source": "/superadmin/login", "destination": "/superadmin/login.html" },
    { "source": "/admin.css", "destination": "/superadmin/admin.css" },
    { "source": "/admin.js", "destination": "/superadmin/admin.js" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/receipt", "destination": "/receipt.html" }
  ]
}
