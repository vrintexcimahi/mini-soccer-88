# Environment Variables — Mini Soccer 88 Alpha Sport Payment Gateway
# Salin file ini ke ".env" dan isi nilai yang sesuai
# JANGAN commit file .env ke repository!

# ============================
# Midtrans Configuration
# ============================
# Daftar akun di: https://dashboard.midtrans.com
# Gunakan kunci SANDBOX untuk development/testing
# Gunakan kunci PRODUCTION untuk live

# Server Key (rahasia — HANYA di server, jangan di frontend)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx

# Client Key (boleh di frontend untuk Snap.js)
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx

# Set ke "true" untuk menggunakan API production Midtrans
MIDTRANS_IS_PRODUCTION=false

# ============================
# Receipt Security
# ============================
# String acak minimal 32 karakter untuk HMAC receipt token
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECEIPT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-disini

# ============================
# Storage (opsional)
# ============================
# Default: /tmp/ms88_store (ephemeral di Vercel — data hilang saat cold start)
# Untuk production: gunakan Vercel KV, Upstash Redis, atau PostgreSQL
STORE_DIR=/tmp/ms88_store

# ============================
# Webhook URL (untuk konfigurasi di dashboard Midtrans)
# ============================
# Daftarkan URL ini di Midtrans Dashboard > Settings > Configuration > Payment Notification URL:
# https://your-domain.vercel.app/api/webhook-midtrans
#
# Pastikan URL bisa diakses publik (bukan localhost) untuk menerima notifikasi.
# Untuk testing lokal, gunakan: https://smee.io atau https://ngrok.io

# ============================
# Cara Setup Akun Midtrans (Sandbox)
# ============================
# 1. Daftar di https://dashboard.sandbox.midtrans.com
# 2. Settings > Access Keys → copy Server Key & Client Key
# 3. Settings > Configuration → Payment Notification URL: https://your-app.vercel.app/api/webhook-midtrans
# 4. Isi nilai di file .env ini
# 5. Jalankan: node api/_test.js untuk verifikasi
